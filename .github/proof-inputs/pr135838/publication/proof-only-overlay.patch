+function deriveNativeCommandBinding(consumer, publicSdk, resolveModule, readModule) {
+  const parse = (document) => parseJavaScript(document.source, { ecmaVersion: "latest", sourceType: "module" }).body;
+  const identifier = (node) => {
+    assert.equal(node?.type, "Identifier", "named identifier syntax required");
+    assert.match(node.name, /^[A-Za-z_$][A-Za-z0-9_$]*$/);
+    return node.name;
+  };
+  const one = (items, label) => {
+    assert.equal(items.length, 1, "one unambiguous " + label);
+    return items[0];
+  };
+  const exports = (body) => {
+    assert(!body.some((node) => node.type === "ExportAllDeclaration"), "star-export linkage unsupported");
+    return body.filter((node) => node.type === "ExportNamedDeclaration").flatMap((node) =>
+      node.specifiers.map((specifier) => ({ node, specifier })));
+  };
+  const imports = (body) => body.filter((node) => node.type === "ImportDeclaration").flatMap((node) =>
+    node.specifiers.map((specifier) => ({ node, specifier })));
+  const resolveImport = (entry, document) => {
+    assert.equal(entry.specifier.type, "ImportSpecifier", "direct named import required");
+    assert.equal(entry.node.attributes?.length ?? 0, 0, "import attributes unsupported");
+    assert.equal(typeof entry.node.source.value, "string");
+    assert(/^\.{1,2}\//.test(entry.node.source.value), "relative emitted import required");
+    return resolveModule(entry.node.source.value, document.url);
+  };
+  const publicBody = parse(publicSdk);
+  const publicExport = one(exports(publicBody).filter(({ specifier }) =>
+    specifier.exported.type === "Identifier" && specifier.exported.name === "runCommandWithTimeout"), "public SDK export");
+  assert.equal(publicExport.node.source, null, "direct public import/local-export required");
+  const publicLocal = identifier(publicExport.specifier.local);
+  const publicImport = one(imports(publicBody).filter(({ specifier }) => specifier.local.name === publicLocal), "public SDK import");
+  const chunkUrl = resolveImport(publicImport, publicSdk);
+  const alias = identifier(publicImport.specifier.imported);
+  const consumerImport = one(imports(parse(consumer)).filter((entry) =>
+    entry.specifier.type === "ImportSpecifier" && entry.specifier.imported.type === "Identifier" &&
+    entry.specifier.imported.name === alias && /^\.{1,2}\//.test(entry.node.source.value) &&
+    resolveImport(entry, consumer) === chunkUrl), "consumer/common-chunk binding");
+  const chunk = readModule(chunkUrl);
+  assert.equal(chunk.url, chunkUrl);
+  const chunkBody = parse(chunk);
+  const chunkExport = one(exports(chunkBody).filter(({ specifier }) =>
+    specifier.exported.type === "Identifier" && specifier.exported.name === alias), "common-chunk export");
+  assert.equal(chunkExport.node.source, null, "chunk re-export indirection unsupported");
+  const chunkLocal = identifier(chunkExport.specifier.local);
