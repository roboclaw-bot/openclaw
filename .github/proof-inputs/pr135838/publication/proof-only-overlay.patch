+    (node.type === "FunctionDeclaration" && node.id?.name === chunkLocal) ||
+    (node.type === "VariableDeclaration" && node.declarations.some((item) => item.id.type === "Identifier" && item.id.name === chunkLocal))),
+  "chunk export must own its declaration");
+  const receipt = (document) => ({ url: document.url, sha256: HASH(document.source) });
